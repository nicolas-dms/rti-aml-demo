# =====================================================================
# demo.config.env - LE SEUL fichier de parametres de la demo RTI x AML
# =====================================================================
# Lu par tous les scripts (scripts/lib/cfg.ps1), les notebooks (a la
# publication), les pipelines Azure DevOps (au checkout) et le script
# Python 72. Aucun secret ici : jetons, cles et chaines de connexion
# restent dans .env (ignore par git) ou dans les settings de la Function.
#
# Format : CLE=valeur, une par ligne, pas de commentaire en fin de ligne.
# Une valeur vide ou entre chevrons <...> est consideree comme non renseignee.
# Surcharge ponctuelle sans editer le fichier : variable d'environnement RTI_<CLE>.
#
# Marche a suivre : voir docs/QUICKSTART.md. Commencer par
#   .\scripts\00a_init_config.ps1     (pre-remplit ce fichier depuis az)
#   .\scripts\00b_preflight.ps1       (verifie ce fichier et le poste)
# =====================================================================


# ---------------------------------------------------------------------
# 1. Azure  (obligatoire)
# ---------------------------------------------------------------------
# az account show --query "{sub:id,tenant:tenantId}"
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Region des ressources Azure. La capacite Fabric doit etre dans la meme region
# (sinon OneLake -> ADLS et les lectures du notebook traversent les regions).
AZURE_LOCATION=westus3
# Un seul groupe de ressources porte tout : stockage, AML DEV et PROD, registre, Function.
AZURE_RESOURCE_GROUP=rg-rti-aml-demo


# ---------------------------------------------------------------------
# 2. Noms Azure ML
# ---------------------------------------------------------------------
AML_DEV_WORKSPACE=aml-rti-demo
AML_PROD_WORKSPACE=aml-rti-prod
# Le nom d'un registre doit etre UNIQUE DANS LE TENANT : ajoutez un suffixe a vous.
AML_REGISTRY=


# ---------------------------------------------------------------------
# 3. Noms Azure uniques mondialement
#    Laisser vide = 00_bootstrap.ps1 derive un nom depuis un hash de
#    <subscription>/<resource group> et l'ecrit ici.
#    3 a 24 caracteres, minuscules et chiffres uniquement.
# ---------------------------------------------------------------------
# Compte ADLS Gen2 : snapshots d'entrainement + stockage du datastore AML.
STORAGE_ACCOUNT=
# Stockage interne de la Function App.
FUNCTION_STORAGE_ACCOUNT=
# Nom de la Function App (unique dans azurewebsites.net).
FUNCTION_APP=


# ---------------------------------------------------------------------
# 4. Microsoft Fabric
# ---------------------------------------------------------------------
# Capacite Fabric EXISTANTE (F2 ou plus, ou essai) et son groupe de ressources.
# Elle n'est pas creee par les scripts : voir le guide, etape prerequis.
FABRIC_CAPACITY=
FABRIC_CAPACITY_RESOURCE_GROUP=
# Noms des elements Fabric crees par scripts/10_fabric_rti.ps1 et 12_fabric_eventstream.ps1.
FABRIC_WORKSPACE=ws-rti-aml-demo
EVENTHOUSE=eh-sensors
KQL_DATABASE=sensors
EVENTSTREAM=es-sensors


# ---------------------------------------------------------------------
# 5. Azure DevOps  (facultatif : uniquement pour la piste C en pipelines)
#    Sans Azure DevOps, le guide explique comment lancer les memes etapes
#    a la main (scripts 20 et 80).
# ---------------------------------------------------------------------
ADO_ORGANIZATION=
ADO_PROJECT=rti-aml-demo
# Object id des principaux de service derriere les connexions de service
# sc-rti-aml-dev et sc-rti-aml-prod (scripts/71_mlops_rbac.ps1).
# Portail Entra > Applications d'entreprise > l'application > Object ID.
SP_DEV_OBJECT_ID=
SP_PROD_OBJECT_ID=


# ---------------------------------------------------------------------
# 6. Renseigne AUTOMATIQUEMENT par les scripts - ne pas editer
#    (10_fabric_rti.ps1 ecrit ces quatre valeurs)
# ---------------------------------------------------------------------
FABRIC_WORKSPACE_ID=
KQL_DATABASE_ID=
KUSTO_QUERY_URI=
KUSTO_INGEST_URI=


# ---------------------------------------------------------------------
# 7. Options (valeurs par defaut raisonnables, a ne changer que si besoin)
# ---------------------------------------------------------------------
# Log Analytics, uniquement pour scripts/34_function_diagnostics.ps1.
LOG_ANALYTICS_WORKSPACE=
# Datastore AML et filesystem ADLS.
AML_DATASTORE=rti_snapshots
STORAGE_FILESYSTEM=snapshots
# Taille de VM du cluster d'entrainement (min_instances=0 : pas de cout a l'arret).
AML_COMPUTE_SIZE=Standard_DS3_v2


# ---------------------------------------------------------------------
# Conventions figees (NE PAS CHANGER sans editer les YAML correspondants)
# ---------------------------------------------------------------------
# Ces noms sont ecrits en dur dans des fichiers lus par Azure ML ou Azure DevOps,
# qui ne savent pas lire ce fichier :
#   cpu-cluster              aml/pipelines/training_pipeline.yml
#   temp-forecast-ep         aml/endpoints/*.yml (endpoint DEV)
#   temp-forecast-prod-ep    scripts/80_prod_rollout.ps1, 81_prod_endpoint_bootstrap.ps1 (endpoint PROD)
#   temp_forecaster          composants aml/components/*.yml (nom du modele)
#   sc-rti-aml-dev / -prod   devops/pipelines/*.yml (connexions de service)
#   rti-mlops-local          devops/pipelines/*.yml (pool d'agents)
#   rti-prod                 devops/pipelines/publish.yml (environnement a approbation)
