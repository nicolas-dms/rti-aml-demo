# Copy to .env (git-ignored) and fill in. NEVER commit .env.

# Fabric Eventstream "es-sensors" -> Custom endpoint -> Event Hub compatible.
# Portal: Eventstream > source "Custom endpoint" > Event Hub tab >
#         "Connection string-primary key".
EVENTSTREAM_CONNECTION_STRING=

# Only needed if the connection string above has no EntityPath=... segment.
EVENTSTREAM_EVENTHUB_NAME=

# Eventhouse "eh-sensors" query URI (used by the Function and by notebooks).
# Portal: Eventhouse > System overview > Query URI.
KUSTO_CLUSTER_URI=
KUSTO_DATABASE=sensors

# AML managed online endpoint (filled in at P5).
AML_SCORING_URI=
