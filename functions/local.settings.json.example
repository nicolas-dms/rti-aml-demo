{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",

    "KUSTO_CLUSTER_URI": "<KUSTO_QUERY_URI from demo.config.env>",
    "KUSTO_INGEST_URI": "<KUSTO_INGEST_URI from demo.config.env>",
    "KUSTO_DATABASE": "sensors",

    "AML_SCORING_URI": "PASTE_THE_SCORING_URI_PRINTED_BY_scripts/30_aml_endpoint.ps1",
