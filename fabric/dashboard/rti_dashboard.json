  "baseQueries": [],
  "queries": [
    {
      "id": "44444444-0000-4000-8000-000000000001",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "11111111-1111-4111-8111-111111111111"
      },
      "text": "union\n  (telemetry       | summarize stream = \"1. telemetry (Eventstream)\",  rows = count(), newest = max(timestamp), ingest_lag = now() - max(ingestion_time())),\n  (scoring_results | summarize stream = \"2. scoring_results (Function)\", rows = count(), newest = max(scored_at), ingest_lag = now() - max(ingestion_time()))\n| extend age = now() - newest\n| extend status = case(isnull(newest), \"ARRETE\", ingest_lag < 3m, \"OK\", ingest_lag < 10m, \"EN RETARD\", \"ARRETE\")\n| project stream, status, rows, newest, age, ingest_lag\n| sort by stream asc"
    },
    {
      "id": "44444444-0000-4000-8000-000000000002",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "11111111-1111-4111-8111-111111111111"
      },
      "text": "telemetry\n| where timestamp > ago(30m)\n| summarize temperature_c = avg(temperature_c) by bin(timestamp, 1m), device_id\n| sort by timestamp asc"
    },
    {
      "id": "44444444-0000-4000-8000-000000000003",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "11111111-1111-4111-8111-111111111111"
      },
      "text": "let horizon = 15m;\nlet actual = telemetry\n    | where timestamp > ago(2h)\n    | summarize actual = avg(temperature_c) by device_id, t = bin(timestamp, 1m);\nscoring_results\n| where scored_at > ago(2h)\n| extend t = bin(scored_at + horizon, 1m)\n| summarize predicted = avg(predicted_temperature_c) by device_id, t\n| join kind=leftouter actual on device_id, t\n| project t, device_id, predicted, actual\n| sort by t asc"
    },
    {
      "id": "44444444-0000-4000-8000-000000000004",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "11111111-1111-4111-8111-111111111111"
      },
      "text": "scoring_results\n| where scored_at > ago(1h)\n| summarize predictions = count() by bin(scored_at, 2m), deployment\n| sort by scored_at asc"
    },
    {
      "id": "44444444-0000-4000-8000-000000000005",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "11111111-1111-4111-8111-111111111111"
      },
      "text": "let horizon = 15m;\nlet actual = telemetry\n    | where timestamp > ago(4h)\n    | summarize actual = avg(temperature_c) by device_id, t = bin(timestamp, 1m);\nscoring_results\n| where scored_at > ago(4h)\n| extend t = bin(scored_at + horizon, 1m)\n| join kind=inner actual on device_id, t\n| summarize MAE = avg(abs(predicted_temperature_c - actual)) by deployment, bin(t, 5m)\n| sort by t asc"
    },
    {
      "id": "44444444-0000-4000-8000-000000000006",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "11111111-1111-4111-8111-111111111111"
      },
      "text": "scoring_results\n| where scored_at > ago(1h)\n| summarize predictions = count() by deployment\n| sort by predictions desc"
    },
    {
      "id": "44444444-0000-4000-8000-000000000007",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "11111111-1111-4111-8111-111111111111"
      },
      "text": "let lookback = 1h;\nlet total = toscalar(scoring_results | where scored_at > ago(lookback) | count);\nscoring_results\n| where scored_at > ago(lookback)\n| summarize predictions = count(),\n            model = strcat(max(model_name), \":\", max(model_version)),\n            newest = max(scored_at)\n        by deployment\n| extend share_pct = round(100.0 * predictions / total, 1)\n| project deployment, model, predictions, share_pct, newest\n| sort by predictions desc"
    }
  ],
