// | render columnchart with (kind = stacked)
//
// -- prediction vs. reality, once the horizon has elapsed
// scoring_results
// | where scored_at > ago(1h)
// | extend target_time = scored_at + 15m
// | join kind=inner (
//     telemetry
//     | summarize actual = avg(temperature_c) by device_id, bin(timestamp, 1m)
//   ) on device_id, $left.target_time == $right.timestamp
// | extend abs_error = abs(predicted_temperature_c - actual)
// | summarize mae = avg(abs_error) by deployment, model_version
