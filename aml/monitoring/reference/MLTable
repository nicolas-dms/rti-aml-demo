# MLTable view of the training snapshot, used as the monitoring REFERENCE data.
#
# Why this file exists at all: model monitoring requires reference_data to be of
# type `mltable`. Our training data asset telemetry_features is a `uri_folder`
# (see aml/data/data-asset.yml) because the training pipeline globs it with
# pandas. The two contracts are incompatible, so the same Parquet file is
# exposed twice, under two types. Nothing is copied - both point at the same
# blob.
#
# keep_columns is not cosmetic. The snapshot also carries `device_id` and
# `minute`, which are NOT model features: the endpoint never receives them.
# Leaving them in would make the monitor compare columns that cannot possibly
# appear in the production data, producing schema noise on every run.
#
# target_temperature_c IS kept: feature importance (top_n_feature_importance)
# needs the target column to rank features.

$schema: https://azuremlschemas.azureedge.net/latest/MLTable.schema.json
type: mltable

paths:
  - file: azureml://datastores/rti_snapshots/paths/telemetry/v1/telemetry_features.parquet

transformations:
  - read_parquet
  - keep_columns:
      - temperature_c
      - humidity_pct
      - pressure_bar
      - vibration_mm_s
      - temperature_c_lag1
      - temperature_c_lag5
      - temperature_c_lag15
      - humidity_pct_lag1
      - humidity_pct_lag5
      - humidity_pct_lag15
      - pressure_bar_lag1
      - pressure_bar_lag5
      - pressure_bar_lag15
      - vibration_mm_s_lag1
      - vibration_mm_s_lag5
      - vibration_mm_s_lag15
      - temperature_c_mean30
      - temperature_c_std30
      - vibration_mm_s_mean30
      - vibration_mm_s_std30
      - temperature_slope15
      - hour_of_day
      - target_temperature_c
